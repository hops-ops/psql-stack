# code: language=yaml
{{- $backup := $state.backup }}
{{- if and $backup.enabled $backup.monitoring.enabled }}
{{- $labels := mergeOverwrite (deepCopy $state.labels) $backup.monitoring.labels }}
{{- $selector := printf "job=\"cnpg-backups\",namespace=%q,cnpg_cluster=%q,cnpg_role=\"primary\"" $state.namespace $state.name }}
{{- $success := printf "max(barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{%s})" $selector }}
{{- $failure := printf "max(barman_cloud_cloudnative_pg_io_last_failed_backup_timestamp{%s})" $selector }}
{{- $rules := list
  (dict "alert" "PostgresBackupMetricsMissing" "expr" (printf "absent(up{%s} == 1) or absent(cnpg_collector_up{%s} == 1)" $selector $selector) "for" "15m" "labels" (dict "severity" $backup.monitoring.criticalSeverity) "annotations" (dict "summary" "Database primary backup telemetry is unavailable"))
  (dict "alert" "PostgresBackupNeverCompleted" "expr" (printf "absent(barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{%s} > 0)" $selector) "for" "30m" "labels" (dict "severity" $backup.monitoring.criticalSeverity) "annotations" (dict "summary" "Database has no available physical backup"))
  (dict "alert" "PostgresBackupStale" "expr" (printf "time() - (%s > 0) > %v" $success $backup.monitoring.maxBackupAgeSeconds) "for" "15m" "labels" (dict "severity" $backup.monitoring.criticalSeverity) "annotations" (dict "summary" "Database physical backup exceeded its maximum age"))
  (dict "alert" "PostgresBackupFailed" "expr" (printf "%s > (%s or vector(0))" $failure $success) "for" "15m" "labels" (dict "severity" $backup.monitoring.warningSeverity) "annotations" (dict "summary" "Database backup failed after the last successful backup"))
  (dict "alert" "PostgresWALArchiveBacklog" "expr" (printf "max(cnpg_collector_pg_wal_archive_status{%s,value=\"ready\"}) > 0" $selector) "for" "15m" "labels" (dict "severity" $backup.monitoring.criticalSeverity) "annotations" (dict "summary" "Database primary has a persistent WAL archive backlog"))
}}
{{- range $rules }}
  {{- $_ := set .labels "namespace" $state.namespace }}
  {{- $_ := set .labels "cnpg_cluster" $state.name }}
{{- end }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: {{ $state.name }}-backup-monitor
  annotations:
    {{ setResourceNameAnnotation "backup-monitor" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
        name: {{ $state.name }}-backups
        namespace: {{ $state.namespace }}
        labels: {{ $labels | toJson }}
      spec:
        selector:
          matchLabels:
            cnpg.io/cluster: {{ $state.name }}
        podMetricsEndpoints:
        - port: metrics
          interval: 60s
          scrapeTimeout: 10s
          relabelings:
          - sourceLabels: [__meta_kubernetes_pod_label_cnpg_io_cluster]
            targetLabel: cnpg_cluster
          - sourceLabels: [__meta_kubernetes_pod_label_cnpg_io_instanceRole]
            targetLabel: cnpg_role
          - targetLabel: job
            replacement: cnpg-backups
          metricRelabelings:
          - sourceLabels: [__name__]
            action: keep
            regex: cnpg_collector_up|cnpg_collector_pg_wal_archive_status|barman_cloud_cloudnative_pg_io_.*
  providerConfigRef: {{ $state.kubernetesProviderConfigRef | toJson }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: {{ $state.name }}-backup-alerts
  annotations:
    {{ setResourceNameAnnotation "backup-alerts" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
        name: {{ $state.name }}-backups
        namespace: {{ $state.namespace }}
        labels: {{ $labels | toJson }}
      spec:
        groups:
        - name: {{ printf "%s.%s.postgres.backups" $state.namespace $state.name }}
          interval: 60s
          rules: {{ $rules | toJson }}
  providerConfigRef: {{ $state.kubernetesProviderConfigRef | toJson }}
{{- end }}
