# code: language=yaml
#
# StorageClass: psql-ebs (durable EBS gp3, no CoW)
#
# Always-on fallback profile. Uses the EKS Auto Mode CSI driver
# (ebs.csi.eks.amazonaws.com). Branching against this profile uses
# pg_basebackup (no VolumeSnapshotClass — EBS snapshots are not CoW
# at restore, so they don't give the instant-fork semantics PSQLBranch
# expects from a snapshot path).
#

{{- $ebs := $state.storage.ebs }}
{{- if $ebs.enabled }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: {{ $state.name }}-storageclass-ebs
  annotations:
    {{ setResourceNameAnnotation "storageclass-ebs" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: {{ $ebs.storageClassName }}
        labels: {{ $state.labels | toJson }}
      provisioner: {{ $ebs.provisioner }}
      parameters: {{ $ebs.parameters | toJson }}
      reclaimPolicy: {{ $ebs.reclaimPolicy }}
      volumeBindingMode: {{ $ebs.volumeBindingMode }}
      allowVolumeExpansion: {{ $ebs.allowVolumeExpansion }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
