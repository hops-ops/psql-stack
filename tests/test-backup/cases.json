      "compositionPath": "apis/psqlclusters/composition.yaml",
      "xrdPath": "apis/psqlclusters/definition.yaml",
      "timeoutSeconds": 90,
      "validate": false,
      "xr": {
        "apiVersion": "hops.ops.com.ai/v1alpha1",
        "kind": "PSQLCluster",
        "metadata": {
          "name": "app-db",
