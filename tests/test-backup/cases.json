[
  {
    "metadata": {
      "name": "managed-backup-policy"
    },
    "spec": {
      "compositionPath": "apis/psqlclusters/composition.yaml",
      "xrdPath": "apis/psqlclusters/definition.yaml",
      "timeoutSeconds": 90,
      "validate": false,
      "xr": {
        "apiVersion": "hops.ops.com.ai/v1alpha1",
        "kind": "PSQLCluster",
        "metadata": {
          "name": "app-db",
          "namespace": "databases"
        },
        "spec": {
          "clusterName": "production",
          "storage": {
            "size": "10Gi"
          },
          "backup": {
            "enabled": true,
            "destinationPath": "s3://database-backups/production",
            "credentials": {
              "inheritFromIAMRole": true
            },
            "schedule": {
              "cron": "0 0 6 * * *"
            },
            "monitoring": {
              "enabled": false,
              "labels": {
                "release": "prometheus"
              }
            }
          }
        }
      },
      "assertResources": [
        {
          "apiVersion": "kubernetes.m.crossplane.io/v1alpha1",
          "kind": "Object",
          "metadata": {
            "name": "app-db-cnpg-cluster"
          },
          "spec": {
            "forProvider": {
              "manifest": {
                "spec": {
                  "plugins": [
                    {
                      "name": "barman-cloud.cloudnative-pg.io",
                      "isWALArchiver": true,
                      "parameters": {
                        "barmanObjectName": "app-db-backups",
                        "serverName": "app-db"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "apiVersion": "kubernetes.m.crossplane.io/v1alpha1",
          "kind": "Object",
          "metadata": {
            "name": "app-db-backup-objectstore"
          },
          "spec": {
            "forProvider": {
              "manifest": {
                "spec": {
                  "configuration": {
                    "destinationPath": "s3://database-backups/production"
                  },
                  "retentionPolicy": "30d"
                }
              }
            },
            "managementPolicies": [
              "Observe",
              "Create",
              "Update",
              "LateInitialize"
            ]
          }
        },
        {
          "apiVersion": "kubernetes.m.crossplane.io/v1alpha1",
          "kind": "Object",
          "metadata": {
            "name": "app-db-backup-schedule"
          },
          "spec": {
            "forProvider": {
              "manifest": {
                "spec": {
                  "schedule": "0 0 6 * * *",
                  "target": "primary",
                  "immediate": false,
                  "backupOwnerReference": "none"
                }
              }
            },
            "managementPolicies": [
              "Observe",
              "Create",
              "Update",
              "LateInitialize"
            ]
          }
        }
      ]
    }
  },
  {
